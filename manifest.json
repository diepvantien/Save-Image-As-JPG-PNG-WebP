{
  "manifest_version": 3,
  "name": "Save Image As JPG/PNG/WebP",
  "version": "1.0.0",
  "description": "Right-click to gracefully save any image as JPG, PNG, or WebP. Perfectly supports Twitter, Instagram, Facebook, and more.",
  "permissions": [
    "contextMenus",
    "downloads",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Save Image As JPG/PNG/WebP"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
